#pragma once

#include <cstddef>
#include <glm/glm.hpp>

// This header and shaders/gbuffer_layout.glsl are both generated by CMake from
// the same attachment indices. Keep every GBuffer attachment described here.
namespace indoor::gbuffer {

enum Attachment : int {
    WorldPosition = @GBUF_ATTACHMENT_WORLD_POSITION@,
    ViewNormal = @GBUF_ATTACHMENT_VIEW_NORMAL@,
    Albedo = @GBUF_ATTACHMENT_ALBEDO@,
    Surface = @GBUF_ATTACHMENT_SURFACE@,
    AttachmentCount = @GBUF_ATTACHMENT_COUNT@
};

// RT0: RGB = world-space position, A = positive view-space depth.
struct WorldPositionTexel {
    glm::vec4 value;
};

// RT1: XYZ = normalized view-space normal, A = object id (diagnostics).
struct ViewNormalTexel {
    glm::vec4 value;
};

// RT2: RGB = composed linear albedo, A = ambient occlusion.
struct AlbedoTexel {
    glm::vec4 value;
};

// RT3: R = roughness, G = metallic, B = active material preset, A = object id.
struct SurfaceTexel {
    glm::vec4 value;
};

static_assert(sizeof(WorldPositionTexel) == 16);
static_assert(sizeof(ViewNormalTexel) == 16);
static_assert(sizeof(AlbedoTexel) == 16);
static_assert(sizeof(SurfaceTexel) == 16);
static_assert(WorldPosition == 0);
static_assert(ViewNormal == 1);
static_assert(Albedo == 2);
static_assert(Surface == 3);
static_assert(AttachmentCount == 4);

} // namespace indoor::gbuffer
