{
  "output": {
    "path": "demo_mix.wav",
    "sample_rate": 48000,
    "channels": 2,
    "duration_seconds": 5.0,
    "subtype": "PCM_32",
    "limiter_placement": "bus"
  },
  "bus_limiter": {
    "ceiling_dbfs": -1.0,
    "lookahead_ms": 5.0,
    "release_ms": 80.0
  },
  "processing": {
    "workers": 0,
    "chunk_frames": 16384
  },
  "tracks": [
    {
      "id": "dialogue",
      "input": "demo_audio/dialogue.wav",
      "offset_ms": 0.0,
      "gain_db": -2.0,
      "compressor": {
        "threshold_db": -22.0,
        "ratio": 3.0,
        "knee_db": 6.0,
        "attack_ms": 8.0,
        "release_ms": 120.0
      }
    },
    {
      "id": "sfx",
      "input": "demo_audio/sfx.wav",
      "offset_ms": 250.4,
      "gain_db": 10.0
    },
    {
      "id": "music",
      "input": "demo_audio/music.wav",
      "offset_ms": -75.0,
      "gain_db": -5.0
    }
  ]
}
