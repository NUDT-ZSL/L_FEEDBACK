{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vcpkg",
      "displayName": "Windows x64 (vcpkg manifest)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/windows",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "LCR_BUILD_APP": "ON",
        "LCR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "headless-tests",
      "displayName": "Headless deterministic tests",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {
        "LCR_BUILD_APP": "OFF",
        "LCR_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-vcpkg",
      "configuration": "Release"
    },
    {
      "name": "headless",
      "configurePreset": "headless-tests"
    }
  ],
  "testPresets": [
    {
      "name": "windows-tests",
      "configurePreset": "windows-vcpkg",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless",
      "configurePreset": "headless-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

